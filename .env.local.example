# YouTube API (client-side, с ограничениями по домену)
YOUTUBE_API_KEY=ВАШ_YOUTUBE_API_KEY
YOUTUBE_PLAYLIST_ID=ВАШ_ID_ПЛЕЙЛИСТА
# Хэндл канала (с @) — для живой статистики подписчиков/просмотров/видео
YOUTUBE_CHANNEL_HANDLE=@firephoenix6297

# Telegram Bot (используется на сервере в api/send-telegram.ts)
# ВАЖНО: имена должны совпадать с теми, что читает api/send-telegram.ts
TELEGRAM_BOT_TOKEN=ВАШ_ТОКЕН_БОТА
TELEGRAM_CHAT_ID=ВАШ_CHAT_ID

# Supabase (миграция и админка)
# SUPABASE_URL — берётся из Supabase Dashboard -> Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY — service_role (НЕ anon!). Нужен только для seed-скрипта,
#   не использовать в клиентском коде. VITE_SUPABASE_URL и VITE_SUPABASE_ANON_KEY
#   для клиента (админка + публичные SELECT). Префикс VITE_ обязателен — без
#   него Vite не подставит переменную в браузерный бандл.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ВАШ_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=ВАШ_ANON_KEY